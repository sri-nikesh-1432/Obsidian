# Copy to `.env` (git-ignored) and fill in. Everything is optional: with an
# empty file the app still runs fully — Docker serves it with in-process AWS,
# and OTPs/payments are simulated in dev mode.
#
#   cp .env.example .env && docker compose up --build

# ---- Public origin ------------------------------------------------------
# The exact origin users open. Drives CORS, the post-login redirect and the
# Google OAuth redirect URI (<origin>/api/v1/auth/google/callback).
OBSIDIAN_PUBLIC_BASE_URL=http://localhost:8080
OBSIDIAN_API_BASE_URL=http://localhost:8080/api/v1
OBSIDIAN_ALLOWED_ORIGINS=http://localhost:8080

# ---- Google sign-in (all four roles, sign-in and sign-up) ---------------
# Register <origin>/api/v1/auth/google/callback as an Authorized redirect URI
# and <origin> as an Authorized JavaScript origin on the OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Email OTP delivery (real codes) ------------------------------------
# Option A — Resend (used when the key is set)
RESEND_API_KEY=
OBSIDIAN_FROM_EMAIL="OBSIDIAN <onboarding@resend.dev>"
# Option B — SMTP (used when Resend is unset; a Gmail app password works)
OBSIDIAN_SMTP_HOST=
OBSIDIAN_SMTP_PORT=587
OBSIDIAN_SMTP_USERNAME=
OBSIDIAN_SMTP_PASSWORD=

# ---- Razorpay storage payments (test mode) ------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Runtime ------------------------------------------------------------
# true  = OTPs shown in the UI, payments simulated, no AWS needed (demo)
# false = fail-closed; configure the channels above first
OBSIDIAN_DEV_MODE=true

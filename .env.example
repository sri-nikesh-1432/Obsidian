# Copy to `.env` (git-ignored) and fill in. Everything is optional: with an
# empty file the app still runs fully — Docker serves it with in-process AWS,
# and OTPs/payments are simulated in dev mode.
#
#   cp .env.example .env && docker compose up --build

# ---- Public origin ------------------------------------------------------
# The exact origin users open. Drives CORS, the post-login redirect and the
# Google OAuth redirect URI (<origin>/api/v1/auth/google/callback).
OBSIDIAN_PUBLIC_BASE_URL=http://localhost:8080
OBSIDIAN_API_BASE_URL=http://localhost:8080/api/v1
OBSIDIAN_ALLOWED_ORIGINS=http://localhost:8080

# ---- Google sign-in (all four roles, sign-in and sign-up) ---------------
# Register <origin>/api/v1/auth/google/callback as an Authorized redirect URI
# and <origin> as an Authorized JavaScript origin on the OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Email OTP delivery (real codes) ------------------------------------
# Option A — Resend (used when the key is set)
RESEND_API_KEY=
OBSIDIAN_FROM_EMAIL="OBSIDIAN <onboarding@resend.dev>"
# Option B — SMTP (used when Resend is unset; a Gmail app password works)
OBSIDIAN_SMTP_HOST=
OBSIDIAN_SMTP_PORT=587
OBSIDIAN_SMTP_USERNAME=
OBSIDIAN_SMTP_PASSWORD=

# ---- Razorpay storage payments (test mode) ------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Cloudflare R2 object storage (optional) ----------------------------
# Store encrypted document bodies in Cloudflare R2 instead of AWS S3. Create
# the R2 S3 credentials under: dashboard -> R2 -> Manage R2 API Tokens ->
# Create API Token -> "Object Read & Write" for your bucket. The endpoint is
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com and OBSIDIAN_DOCUMENT_BUCKET
# must be your existing R2 bucket name (create it first — R2 has no
# create-bucket API). Leave OBSIDIAN_STORAGE_BACKEND unset to keep using S3.
OBSIDIAN_STORAGE_BACKEND=s3
OBSIDIAN_R2_ENDPOINT=
OBSIDIAN_R2_ACCESS_KEY_ID=
OBSIDIAN_R2_SECRET_ACCESS_KEY=
OBSIDIAN_R2_REGION=auto
# OBSIDIAN_DOCUMENT_BUCKET=obsidian-documents

# ---- Cloudflare Workers KV object storage (optional, cardless) ----------
# Alternative to R2 for the Workers Free plan (no payment method required).
# Workers KV is NOT S3-compatible; the app talks to the KV REST API directly.
# Create the namespace under dashboard -> Workers & Pages -> KV, or via the API
# (POST /accounts/<ACCOUNT_ID>/storage/kv/namespaces {"title": "..."}). The
# API token must grant "Workers KV Storage: Edit". Set
# OBSIDIAN_STORAGE_BACKEND=kv to use it. Free tier: 1 GB storage, 25 MiB max
# value, 1,000 writes/day; reads are eventually consistent.
# OBSIDIAN_STORAGE_BACKEND=kv
OBSIDIAN_CF_ACCOUNT_ID=
OBSIDIAN_CF_API_TOKEN=
OBSIDIAN_KV_NAMESPACE_ID=
# OBSIDIAN_CF_API_BASE=https://api.cloudflare.com/client/v4

# ---- Runtime ------------------------------------------------------------
# true  = OTPs shown in the UI, payments simulated, no AWS needed (demo)
# false = fail-closed; configure the channels above first
OBSIDIAN_DEV_MODE=true
